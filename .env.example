# Frontend environment template — copy to `.env` and fill in values.
# NEVER commit `.env` (it is gitignored). NEVER paste real secrets into this file.

# REQUIRED for auth middleware (fail-closed if unset):
# must be the SAME value as the backend's `jwt_access_secret`.
# Without it, src/service/currentUser.ts rejects every access token and
# all protected routes redirect to /login.
JWT_ACCESS_SECRET=

# API base URLs (NEXT_PUBLIC_LIVE_API must be set for production builds;
# development uses NEXT_PUBLIC_BASE_API when NEXT_PUBLIC_WORKSPACE=development)
NEXT_PUBLIC_WORKSPACE=development
NEXT_PUBLIC_BASE_API=http://localhost:5000/api/v1
NEXT_PUBLIC_LIVE_API=
NEXT_PUBLIC_SOCKET_HOST=

# NextAuth (Google sign-in flow)
# NEXTAUTH_URL must match the deployed origin, e.g. http://localhost:3000
NEXTAUTH_URL=
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Google OAuth client (Google Cloud Console → Credentials → OAuth client ID).
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
# The client SECRET is server-only — never prefix it with NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (existing uploads)
NEXT_PUBLIC_CLOUDINARY_URL=
