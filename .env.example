# Frontend environment template — copy to `.env` and fill in values.
# NEVER commit `.env` (it is gitignored). NEVER paste real secrets into this file.

# REQUIRED for auth middleware (fail-closed if unset):
# must be the SAME value as the backend's `jwt_access_secret`.
# Without it, src/service/currentUser.ts rejects every access token and
# all protected routes redirect to /login.
JWT_ACCESS_SECRET=
